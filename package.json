{
  "name": "math-genius",
  "productName": "Math Genius",
  "version": "2.0.0",
  "description": "Professional Mathematics Learning Platform",
  "main": "main.js",
  "author": "Lakshmi Kanta Samanta",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test:local-rule-engine": "node scripts/test-local-rule-engine.js",
    "test:ocr-solve": "node scripts/test-ocr-solve-pipeline.js",
    "test:algebra": "node scripts/test-algebra-rule-engine.js",
    "test:solver": "npm run test:local-rule-engine && npm run test:ocr-solve && npm run test:solver-validation && npm run test:algebra",
    "build": "electron-builder",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.mathgenius.desktop",
    "productName": "Math Genius",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/Math-Genius-logo-png.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [
    "mathematics",
    "education",
    "learning",
    "algebra",
    "geometry"
  ],
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^5.1.1"
  }
}
